    <string name="onboarding_welcome_title">Welcome to Autogram</string>
    <string name="onboarding_welcome_body">The hands-free way to send voice messages on Telegram. Let\'s get you set up in four quick steps.</string>
    <string name="onboarding_record_title">Press and hold to record</string>
    <string name="onboarding_record_body">Hold down the big circle to record a voice message. Release to send. That\'s it — no typing, no menus.</string>
    <string name="onboarding_target_title">Pick your main target</string>
    <string name="onboarding_target_body">This is the chat you talk to most — the one you get in the big circle. You can change it anytime from Settings.</string>
