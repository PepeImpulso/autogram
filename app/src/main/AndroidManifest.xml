<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime perm on API 31+; granted automatically on lower levels. Only used
         to read connected audio device info so playback can target BT / car. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- MtprotoReceiverService uses specialUse because "dataSync" on
         Android 14+ has a 6-hour budget that Google is enforcing
         progressively; our receiver is a continuous MTProto long-poll
         and doesn't fit any of the 10 standard subtypes. specialUse
         requires declaring a sub-type property on the service tag. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Kept for back-compat with older Android 10-13 where the type
         is parsed but doesn't enforce a budget. Newer targets use
         SPECIAL_USE above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- v1.22.1 — needed for the MediaBrowserServiceCompat that
         surfaces Autogram in Android Auto's media tab. The media
         browser service binds Auto's media controller; it doesn't
         actually run as a foreground service today, but the perm
         covers the case if we promote it later. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Required on API 30+ so SpeechRecognizer can find a recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AutogramApplication"
        android:allowBackup="false"
        android:appCategory="social"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autogram"
        tools:targetApi="35">

        <!-- Phone UI -->
        <activity
            android:name=".ui.phone.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Autogram">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.22.4 — declares Autogram as a target for AA/Assistant
                 voice search ("Hey Google, play X on Autogram"). Paired with
                 the MediaSessionCompat.Callback.onPlayFromSearch override in
                 AutogramMediaPlaybackController; without both, voice-launched
                 playback can't reach the app. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.phone.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.AcceptableUseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.TargetPickerActivity"
            android:exported="false"
            android:label="@string/target_picker_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.ManagePinnedActivity"
            android:exported="false"
            android:label="@string/pinned_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.PinnedPickerActivity"
            android:exported="false"
            android:label="@string/picker_add_shortcut_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.QuickRepliesSettingsActivity"
            android:exported="false"
            android:label="@string/quick_replies_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.TelegramLoginActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.phone.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait" />

        <!-- Issue #63 (Phase 1) — Android digital-assistant role.
             ACTION_ASSIST is the supported entry point for apps that
             want to appear in Settings > Apps > Default apps > Digital
             assistant (Samsung One UI: "Default digital assistant
             app"). VOICE_COMMAND is the older alias some pickers
             additionally check. We export this Activity because the
             OS launches it from the assistant gesture — it must be
             reachable from outside the app. Phase 1 ships a
             placeholder UI; the voice-loop wiring lives behind later
             phases and won't be enabled until we've verified the
             registration end-to-end on a real Samsung device. -->
        <activity
            android:name=".ui.assistant.AssistantActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Autogram">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Issue #63 Phase 1b (v1.23.0-rc.4) — VoiceInteractionService
             chain so Samsung's long-press-home / side-key assistant
             gesture actually routes to Autogram. ACTION_ASSIST alone
             only registers Autogram in the Default-assistant picker;
             this service is what the OS BINDS when the gesture fires.
             Both services need android:permission="android.permission.
             BIND_VOICE_INTERACTION" — system-only permission, prevents
             non-system processes from impersonating us. -->
        <service
            android:name=".ui.assistant.AutogramVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant_metadata" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".ui.assistant.AutogramVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- v1.22.1 — MediaBrowserServiceCompat that makes Autogram a
             "media app" in Android Auto's media tab. Required for
             audio playback to route through the car's media stream
             (especially on USB AA where the phone speaker is muted by
             AA's audio policy and audio without a registered Media-
             Session ends up in the void). The service exposes a
             browseable catalog (pending + history) and publishes the
             same MediaSessionCompat token the AutogramMediaPlayback-
             Controller updates from PlayReplyUseCase, so AA observes
             our PLAYING state. -->
        <service
            android:name=".service.AutogramMediaBrowserService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Foreground Service for MTProto receive loop. specialUse
             because Android 14+ reclaims dataSync-typed services on
             a 6-hour budget; our receiver keeps a TDLib long-poll
             open for the lifetime of the session, which doesn't map
             to any of the 10 pre-baked FGS subtypes.
             v1.24.0 — adds mediaPlayback so the audio path Autogram
             triggers from this service (PlayReplyUseCase → AudioPlayer /
             TtsPlayer) is treated as legitimate media playback by
             Android 14+'s background-audio policy. Without it, AA's
             audio policy can silently route our playback into a muted
             channel even when MediaSession is correctly active. -->
        <service
            android:name=".service.MtprotoReceiverService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse|mediaPlayback">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="MtprotoReceiverService continuously maintains a TDLib MTProto session for Autogram so incoming voice messages can be received, notified to Android Auto, and played aloud without requiring the user to keep the app open on the phone." />
        </service>

        <!-- Handles Listen/Reply actions posted on incoming-message notifications.
             Not exported — only our own PendingIntents trigger it. -->
        <receiver
            android:name=".infrastructure.platform.NotificationActionReceiver"
            android:exported="false" />

        <!-- v1.22.4 — routes hardware media-button events (Bluetooth headset
             play/pause, wired headset remote, keyboard play key) to the
             topmost active MediaSession. Without this, Bluetooth headsets
             paired to the phone can't pause/resume Autogram playback;
             AA itself uses a controller-binder path so it isn't affected,
             but headset users in the car would lose transport control. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile for instant "record voice to primary target".
             Drag-and-drop into the QS panel from the edit screen on Android.
             Tap: launches MainActivity with EXTRA_AUTO_RECORD so the user can
             hold-to-record without finding the in-app button. -->
        <service
            android:name=".tiles.RecordVoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_record_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider para el APK descargado por el auto-actualizador -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Required for per-app locale persistence on pre-33 (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Disable default WorkManager init: we provide Configuration.Provider in AutogramApplication for Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
