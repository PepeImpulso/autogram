<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".AutogramApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autogram"
        tools:targetApi="35">

        <!-- Phone UI -->
        <activity
            android:name=".interface.phone.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Autogram">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".interface.phone.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".interface.phone.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".interface.phone.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title" />

        <activity
            android:name=".interface.phone.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".interface.auto.AutogramCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MESSAGING" />
            </intent-filter>
        </service>

        <!-- Foreground Service for Telegram polling -->
        <service
            android:name=".service.AutogramPollingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Disable default WorkManager init: we provide Configuration.Provider in AutogramApplication for Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
