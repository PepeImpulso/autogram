<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Required on API 30+ so SpeechRecognizer can find a recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AutogramApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autogram"
        tools:targetApi="35">

        <!-- Phone UI -->
        <activity
            android:name=".ui.phone.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Autogram">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.phone.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.phone.TargetPickerActivity"
            android:exported="false"
            android:label="@string/target_picker_title" />

        <activity
            android:name=".ui.phone.ManagePinnedActivity"
            android:exported="false"
            android:label="Accesos rápidos" />

        <activity
            android:name=".ui.phone.PinnedPickerActivity"
            android:exported="false"
            android:label="Añadir acceso rápido" />

        <activity
            android:name=".ui.phone.QuickRepliesSettingsActivity"
            android:exported="false"
            android:label="Respuestas rápidas" />

        <activity
            android:name=".ui.phone.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".ui.phone.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title" />

        <activity
            android:name=".ui.phone.TelegramLoginActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/Theme.Autogram.Car" />

        <service
            android:name=".ui.auto.AutogramCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Foreground Service for MTProto receive loop -->
        <service
            android:name=".service.MtprotoReceiverService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider para el APK descargado por el auto-actualizador -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Required for per-app locale persistence on pre-33 (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Disable default WorkManager init: we provide Configuration.Provider in AutogramApplication for Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
