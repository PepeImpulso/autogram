<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime perm on API 31+; granted automatically on lower levels. Only used
         to read connected audio device info so playback can target BT / car. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- MtprotoReceiverService uses specialUse because "dataSync" on
         Android 14+ has a 6-hour budget that Google is enforcing
         progressively; our receiver is a continuous MTProto long-poll
         and doesn't fit any of the 10 standard subtypes. specialUse
         requires declaring a sub-type property on the service tag. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Kept for back-compat with older Android 10-13 where the type
         is parsed but doesn't enforce a budget. Newer targets use
         SPECIAL_USE above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- NavigationTemplate needs this permission. Gearhead grants it
         to any CarAppService that declares the NAVIGATION category
         intent-filter, so this works for sideloaded apps (as long as
         "Unknown sources" is enabled in AA → Developer Settings). -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <!-- setSurfaceCallback() needs a SECOND permission: ACCESS_SURFACE.
         Required for the raw-canvas rendering path (same one Waze /
         Google Maps use). Without it Gearhead refuses the surface
         handoff with "trying to access surface when the permission
         was not granted" in logcat. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Required on API 30+ so SpeechRecognizer can find a recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AutogramApplication"
        android:allowBackup="false"
        android:appCategory="social"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autogram"
        tools:targetApi="35">

        <!-- Phone UI -->
        <activity
            android:name=".ui.phone.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Autogram">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.phone.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.phone.TargetPickerActivity"
            android:exported="false"
            android:label="@string/target_picker_title" />

        <activity
            android:name=".ui.phone.ManagePinnedActivity"
            android:exported="false"
            android:label="@string/pinned_title" />

        <activity
            android:name=".ui.phone.PinnedPickerActivity"
            android:exported="false"
            android:label="@string/picker_add_shortcut_title" />

        <activity
            android:name=".ui.phone.QuickRepliesSettingsActivity"
            android:exported="false"
            android:label="@string/quick_replies_title" />

        <activity
            android:name=".ui.phone.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".ui.phone.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title" />

        <activity
            android:name=".ui.phone.TelegramLoginActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.phone.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- minCarApiLevel=3 so the Android Auto launcher actually surfaces the app.
             Level 1 is accepted but AA hides sideloaded IOT apps that only declare
             level 1 from the launcher in recent versions (14+). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="3" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/Theme.Autogram.Car" />

        <!-- The CarAppService exposes two categories simultaneously:
               - MESSAGING — lets AA route incoming-message notifications
                 (Listen / Reply actions) through the car screen.
               - IOT — lets the service appear in the Android Auto launcher
                 so the user can open the app manually from the car.
             Two separate intent-filters; AA matches either.

             NOTE: for a sideloaded APK to show in the AA launcher the user
             must also enable "Unknown sources" in Android Auto's developer
             settings on the phone (tap the AA version 10 times to unlock). -->
        <!-- The CarAppService exposes the app to Android Auto. Explicit
             icon + label are REQUIRED for the Auto launcher to render the
             tile; without them AA silently hides the app from the grid
             even when the intent-filter is otherwise valid.

             Two intent-filters: MESSAGING so AA routes incoming-message
             notifications (Listen / Reply actions) through the car head
             unit, and IOT so the app appears in the Auto launcher as a
             manually-openable tile.

             NOTE: sideloaded APKs still require the user to enable
             "Unknown sources" inside Android Auto → Developer Settings
             on the phone (tap the Auto version 10 times to unlock). -->
        <service
            android:name=".ui.auto.AutogramCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MESSAGING" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
            <!-- NAVIGATION category unlocks AA's NavigationTemplate + the
                 SurfaceCallback API (AppManager.setSurfaceCallback). With
                 SurfaceCallback we get a raw Canvas to draw the home
                 screen ourselves — big Merlin circle, stacked shortcut
                 chips, small secondary row — which isn't possible in
                 GridTemplate/ListTemplate's fixed uniform-tile layout.
                 Same technique Waze / Google Maps use to render rich UIs
                 on the car head unit. -->
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Foreground Service for MTProto receive loop. specialUse
             because Android 14+ reclaims dataSync-typed services on
             a 6-hour budget; our receiver keeps a TDLib long-poll
             open for the lifetime of the session, which doesn't map
             to any of the 10 pre-baked FGS subtypes. -->
        <service
            android:name=".service.MtprotoReceiverService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="MtprotoReceiverService continuously maintains a TDLib MTProto session for Autogram so incoming voice messages can be received, notified to Android Auto, and played aloud without requiring the user to keep the app open on the phone." />
        </service>

        <!-- Handles Listen/Reply actions posted on incoming-message notifications.
             Not exported — only our own PendingIntents trigger it. -->
        <receiver
            android:name=".infrastructure.platform.NotificationActionReceiver"
            android:exported="false" />

        <!-- Quick Settings tile for instant "record voice to primary target".
             Drag-and-drop into the QS panel from the edit screen on Android.
             Tap: launches MainActivity with EXTRA_AUTO_RECORD so the user can
             hold-to-record without finding the in-app button. -->
        <service
            android:name=".tiles.RecordVoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_record_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider para el APK descargado por el auto-actualizador -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Required for per-app locale persistence on pre-33 (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Disable Sentry's auto-init ContentProvider. It runs before
             Application.onCreate, reads DSN from manifest meta-data, and
             crashes the process if the DSN string is literally empty.
             We init Sentry manually in AutogramApplication so we can
             gracefully skip when SENTRY_DSN is absent (dev builds). -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />

        <!-- Disable default WorkManager init: we provide Configuration.Provider in AutogramApplication for Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
